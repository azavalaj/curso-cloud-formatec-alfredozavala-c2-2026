{
  "name": "Formatec Cloud - Terraform y AWS",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest",
      "tflint": "none",
      "terragrunt": "none"
    },
    "ghcr.io/devcontainers/features/aws-cli:1": {
      "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "HashiCorp.terraform",
        "amazonwebservices.aws-toolkit-vscode",
        "redhat.vscode-yaml",
        "yzhang.markdown-all-in-one"
      ]
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y jq curl nano && terraform version && aws --version && jq --version && git --version"
}
